<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="rust-ssh client" Manufacturer="rust-ssh" Version="$(var.ProductVersion)" UpgradeCode="9F2A0E95-7C8C-4D98-8B76-AF3C5DBA5E11">
    <MajorUpgrade DowngradeErrorMessage="A newer version of rust-ssh client is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="rust-ssh client" Level="1">
      <ComponentRef Id="ClientExecutable" />
      <ComponentRef Id="ClientShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="rust-ssh" />
    </StandardDirectory>

    <Component Id="ClientExecutable" Directory="INSTALLFOLDER">
      <File Id="ClientExe" Source="$(var.BinaryPath)" KeyPath="yes" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="rust-ssh" />
    </StandardDirectory>

    <Component Id="ClientShortcut" Directory="ApplicationProgramsFolder">
      <Shortcut Id="ClientStartMenuShortcut" Name="rust-ssh client" Target="[INSTALLFOLDER]rust-ssh-client.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\rust-ssh" Name="clientInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>

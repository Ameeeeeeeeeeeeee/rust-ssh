<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="rust-ssh client" Manufacturer="rust-ssh" Version="$(var.ProductVersion)" Scope="perUser" UpgradeCode="9F2A0E95-7C8C-4D98-8B76-AF3C5DBA5E11">
    <MajorUpgrade DowngradeErrorMessage="A newer version of rust-ssh client is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="RustSshIcon" SourceFile="$(var.IconPath)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Feature Id="MainFeature" Title="rust-ssh client" Level="1">
      <ComponentRef Id="ClientExecutable" />
      <ComponentRef Id="ClientShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="rust-ssh-client" />
    </StandardDirectory>

    <Component Id="ClientExecutable" Directory="INSTALLFOLDER" Guid="e37de214-42e3-4fed-b54d-8407aae6f591">
      <File Id="ClientExe" Source="$(var.BinaryPath)" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\rust-ssh\Client" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFile Id="RemoveClientExecutable" Name="rust-ssh-client.exe" On="uninstall" />
      <RemoveFolder Id="RemoveClientInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="rust-ssh" />
    </StandardDirectory>

    <Component Id="ClientShortcut" Directory="ApplicationProgramsFolder">
      <Shortcut Id="ClientStartMenuShortcut" Name="rust-ssh client" Target="[INSTALLFOLDER]rust-ssh-client.exe" WorkingDirectory="INSTALLFOLDER" Icon="RustSshIcon" IconIndex="0" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\rust-ssh" Name="clientInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>

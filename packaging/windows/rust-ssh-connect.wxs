<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="rust-ssh connect" Manufacturer="rust-ssh" Version="$(var.ProductVersion)" UpgradeCode="A5C7A43D-8198-47C4-8C29-0F36F519A8E2">
    <MajorUpgrade DowngradeErrorMessage="A newer version of rust-ssh connect is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="rust-ssh connect" Level="1">
      <ComponentRef Id="ConnectExecutable" />
      <ComponentRef Id="ConnectShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="rust-ssh" />
    </StandardDirectory>

    <Component Id="ConnectExecutable" Directory="INSTALLFOLDER">
      <File Id="ConnectExe" Source="$(var.BinaryPath)" KeyPath="yes" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="rust-ssh" />
    </StandardDirectory>

    <Component Id="ConnectShortcut" Directory="ApplicationProgramsFolder">
      <Shortcut Id="ConnectStartMenuShortcut" Name="rust-ssh connect" Target="[INSTALLFOLDER]rust-ssh-connect.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\rust-ssh" Name="connectInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
